[Unit]
Description=StudyBridge 家教撮合平台（studybridge · 38081）
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/studybridge
ExecStart=/usr/local/bin/node /www/wwwroot/studybridge/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 38081
EnvironmentFile=/www/wwwroot/studybridge/.env
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=studybridge

# 安全加固：strict 只读全盘，仅放行运行期必须可写的三处——
# uploads/（本地回退上传）、prisma/（SQLite 库与 journal）、.next/cache（Next 运行期缓存）。
# 源码 / .next 构建产物 / .env 对服务进程只读，RCE 也无法改写源码持久化。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/wwwroot/studybridge/uploads /www/wwwroot/studybridge/prisma /www/wwwroot/studybridge/.next/cache
PrivateTmp=true

[Install]
WantedBy=multi-user.target
