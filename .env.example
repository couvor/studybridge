# 会话签名密钥（生产环境务必换成随机长字符串）
AUTH_SECRET=studybridge-dev-secret-change-me-in-production

# 站点口令门：留空则不启用；设置后全站必须先输入此口令才能访问
# 备案期间建议设置，例如 GATE_PASSWORD=我的口令
GATE_PASSWORD=

# 应用监听地址：备案期间私有访问建议保持 127.0.0.1，通过 SSH 隧道访问
HOST=127.0.0.1
PORT=3000

# Cookie 的 Secure 标记：0 = 允许明文 HTTP 下发（IP:端口直接访问时必须为 0），
# 1 = 仅 HTTPS 下发。浏览器会丢弃明文连接上的 Secure Cookie，
# 配错的表现是「提交成功但下一页弹回登录/口令页」。
# 接入域名 + TLS 后改为 1。
COOKIE_SECURE=0
