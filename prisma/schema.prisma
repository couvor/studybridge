generator client {
  provider = "prisma-client-js"
}

// 数据库：MySQL 5.7（2026-10-20 从 SQLite 迁入）。
// 迁移原因：SQLite 单写锁 + 无网络访问，无法支撑多实例与备份需求。
// 注意：MySQL 5.7 的 TEXT 列不允许 DEFAULT，故长文本一律用 VarChar(2000) 而非 @db.Text。
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 角色：TUTOR 教员 / PARENT 家长 / ADMIN 平台运营
// authSource：LOCAL 本地密码登录（运营/演示）| SSO 明旸账号登录
// ssoSub：login.mingyanginfo.com 的用户 ID；rolePending：SSO 首登待选角色
model User {
  id           String         @id @default(cuid())
  role         String
  email        String         @unique
  passwordHash String
  name         String
  phone        String         @default("")
  ssoSub       String?        @unique
  authSource   String         @default("LOCAL")
  rolePending  Boolean        @default(false)
  // 管理员重置密码后置位：下次本地登录强制先改密（SSO 账号的改密由 loginapp 负责）。
  forcePasswordChange Boolean  @default(false)
  createdAt    DateTime       @default(now())
  tutorProfile TutorProfile?
  demands      Demand[]
  parentOrders Order[]        @relation("ParentOrders")
  notifications Notification[]
}

// 科目分类：LANGUAGE 语言 / CODING 编程 / ART 艺术 / SPORT 体育 / UNI_COURSE 大学课业 / EXAM 考试考证
model Subject {
  id       String         @id @default(cuid())
  name     String         @unique
  category String
  tutors   TutorProfile[] @relation("TutorSubjects")
  demands  Demand[]
}

model TutorProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  university     String        @default("")
  major          String        @default("")
  grade          String        @default("")
  bio            String        @default("") @db.VarChar(2000)
  availableTime  String        @default("") @db.VarChar(2000)
  mode           String        @default("BOTH") // ONLINE | OFFLINE | BOTH
  region         String        @default("")
  studentCardUrl String        @default("") @db.VarChar(500) // 学生证照片（存 uploads/，仅管理员与本人可见）
  transcriptUrl  String        @default("") @db.VarChar(500) // 成绩单
  auditStatus    String        @default("PENDING") // PENDING | APPROVED | REJECTED
  auditNote      String        @default("") @db.VarChar(2000)
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  applications   Application[]
  tutorOrders    Order[]       @relation("TutorOrders")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subjects       Subject[]     @relation("TutorSubjects")
}

// 求教单：status OPEN 撮合中 / MATCHED 已成单 / CLOSED 已关闭
// reviewStatus：需求进入需求大厅前需运营审核 PENDING | APPROVED | REJECTED
model Demand {
  id           String        @id @default(cuid())
  code         String        @unique
  parentId     String
  parent       User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject       @relation(fields: [subjectId], references: [id])
  learnerGrade String        // 学员年级
  mode         String        // ONLINE | OFFLINE
  region       String        @default("")
  frequency    String        @default("")
  budgetNote   String        @default("") @db.VarChar(2000) // 预算仅文字备注，平台不定价
  description  String        @default("") @db.VarChar(2000)
  status       String        @default("OPEN")
  reviewStatus String        @default("PENDING")
  auditNote    String        @default("") @db.VarChar(2000)
  applications Application[]
  orders       Order[]
  createdAt    DateTime      @default(now())
}

model Application {
  id        String   @id @default(cuid())
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  message   String   @default("") @db.VarChar(2000)
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  @@unique([demandId, tutorId])
}

// 撮合单：feeType / feeAmount 为商业模式预留字段，当前一律免费（NONE / 0）
// demandId 唯一：一个需求最多一张撮合单（并发接受/撮合时第二个创建会撞约束失败，防止重复成单）
model Order {
  id            String     @id @default(cuid())
  code          String     @unique
  demandId      String     @unique
  demand        Demand     @relation(fields: [demandId], references: [id])
  parentId      String
  parent        User       @relation("ParentOrders", fields: [parentId], references: [id])
  tutorId       String
  tutor         TutorProfile @relation("TutorOrders", fields: [tutorId], references: [id])
  status        String     @default("ACTIVE") // ACTIVE | FINISHED | CANCELLED
  feeType       String     @default("NONE") // NONE | AGENCY_ONE_TIME（预留）
  feeAmount     Float      @default(0) // 预留：一次性中介服务费
  matchSource   String     @default("PARENT_ACCEPT") // PARENT_ACCEPT | ADMIN_RECOMMEND
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  lessonLogs    LessonLog[]
  reviews       Review[]
}

model LessonLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date      DateTime
  hours     Float
  feedback  String   @default("") @db.VarChar(2000)
  createdAt DateTime @default(now())
}

// 双向评价：authorRole PARENT 家长评教员 / TUTOR 教员评家长
model Review {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorRole String
  rating     Int
  comment    String   @default("") @db.VarChar(2000)
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String   @db.VarChar(2000)
  link      String   @default("") @db.VarChar(500)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 管理操作审计日志（运营在后台执行的高风险操作，如重置密码）。
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String // 操作的管理员用户 id
  actorName    String
  actorRole    String
  targetId     String
  targetEmail  String
  targetRole   String
  action       String // RESET_PASSWORD 等
  detail       String   @default("") @db.VarChar(2000)
  ip           String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
